{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/favicon.ico", "/assets/**"]
      }
    },
    {
      "name": "vendor",
      "installMode": "lazy",
      "resources": {
        "files": ["/*.js"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": ["/api/**"],
      "cacheConfig": { "maxSize": 100, "maxAge": "1d", "strategy": "freshness" }
    }
  ]
}
